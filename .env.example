# Copy this file to .env and adjust for your setup:
#   cp .env.example .env
#
# docker-compose.yml reads .env automatically (same folder) for ${VAR}
# substitution. Keep your real values in .env, not in docker-compose.yml, so a
# future re-delivery of this project (re-extracting the zip, pulling an update)
# never overwrites your settings — only docker-compose.yml itself.
#
# Do NOT wrap values in quotes here — unlike a shell, compose takes the value
# after '=' literally, quotes included (that's also true for a plain
# `environment:` list entry in docker-compose.yml itself).
#
# ORDER OF THIS FILE: oldest entry first, newest last. New settings are always appended at the END
# (never inserted in the middle), so a diff between two deliveries shows exactly what is new.

# Safety fence: browsing/execution is refused outside this path.
MEDIA_ROOT=/mnt/NAS

# Where reusable presets are stored (path inside the container; the volume
# mount in docker-compose.yml makes this persist on the host under ./config).
TIMESTAMP_PRESETS_FILE=/config/presets.json
# Camera names live in the same folder as presets.json
# (/config in Docker) by default -- see CAMERA_NAMES_FILE below.

# Basis-Ordner dropdown shortcuts shown next to "Pfad" in the Timestamp tool:
# comma-separated NAME=path pairs. Each path can optionally end in ":TYPE"
# (ALL|IMAGE|VIDEO) to set the file-type filter for everything under that
# folder explicitly; without it, the type is guessed from the name (contains
# VIDEO -> VIDEO, PHOTO/IMAGE -> IMAGE, otherwise ALL).
# Leave this unset/empty to use the built-in VIDEOS/PHOTOS defaults below.
ROOT_FOLDERS=VIDEOS=/mnt/NAS/video/Home-Video/,PHOTOS=/mnt/NAS/photo/

# --- GPS Sidecar module -----------------------------------------------------
# All of these are services you already self-host -- this container never runs
# or installs any of them, it only ever calls out to their URLs. Leave a whole
# group unset to simply hide/disable that source or backend in the UI.

# Traccar (GPS track source, for files with no GPS of their own): the
# TRACCAR_TOKEN is used as a Bearer token. TRACCAR_DEVICES /
# TRACCAR_DEVICES_ADDITIONAL are each a comma-separated list of
# "deviceId[:Label]" pairs (same ":EXTRA" convention as ROOT_FOLDERS); the
# label is cosmetic only, shown in the UI. Every device from EITHER list is
# shown in the GPS Sidecar UI as its own individually selectable checkbox --
# the only difference is which ones start out checked: TRACCAR_DEVICES are
# your every-day devices (checked by default), TRACCAR_DEVICES_ADDITIONAL are
# ones you only need occasionally (e.g. tagging from someone else's phone) --
# listed and selectable, but unchecked unless you tick them for that browse.
TRACCAR_URL=http://192.168.1.1:8082
TRACCAR_TOKEN=
TRACCAR_DEVICES=7:Phone A - Traccar,19:Phone A - gpslogger
TRACCAR_DEVICES_ADDITIONAL=8:Work phone - HA,11:Phone B - HA,16:Phone C - HA,3:Tablet - Traccar,20:Phone A - HA

# Dawarich (GPS track source, alternative/additional to Traccar).
# DAWARICH_IMPORT_API_KEY is optional -- a second "archive" account (e.g. one
# you backfill with already-geotagged photos via a separate script), queried
# as an extra point source alongside the main account when its checkbox is
# ticked in the UI.
DAWARICH_SERVER=http://192.168.1.33:3000
DAWARICH_API_KEY=
DAWARICH_IMPORT_API_KEY=

# Reverse-geocoding chain, tried in this order until one answers: Photon,
# then Nominatim, then Pelias. MARITIME_SERVER is a last-resort backup for
# coordinates out at sea (a named body of water), only tried once all three
# above have come back empty.
PHOTON_SERVER=http://192.168.1.33:2322
NOMINATIM_SERVER=http://192.168.1.33:4241
PELIAS_SERVER=http://192.168.1.33:4000
MARITIME_SERVER=http://192.168.1.33:5002

# Language for reverse-geocoded location names (Photon/Nominatim/Pelias/
# maritime all take this as a query param).
GEO_LANG=de

# Tiered search radius for matching a file's capture time to the nearest
# Traccar/Dawarich track point: try within GEO_MAX_GAP_SECS first (default
# 10 min), then widen to GEO_MAX_GAP_SECS_TIER2 (default 6h) if nothing was
# found. A file whose nearest point is still further away than that is left
# without a looked-up GPS position.
GEO_MAX_GAP_SECS=600
GEO_MAX_GAP_SECS_TIER2=21600

# --- AI Description module ---------------------------------------------------
# Same variable names as the CLI toolchain's own ~/.GEOCODING/env_nfo_ai, so
# values from an existing setup can be copied in unchanged.
#
# AI_PROVIDER is a priority list: each provider listed here is tried in
# order, falling through to the next on failure. "ollama" alone, "google"
# alone, or "ollama,google" / "google,ollama" are all valid. Leave empty to
# disable AI descriptions entirely (the module still works for browsing
# existing descriptions, but "Beschreibung generieren" will fail for every
# file).
AI_PROVIDER=ollama

# Self-hosted Ollama server + vision-capable model (e.g. qwen2.5vl:3b).
OLLAMA_URL=http://192.168.1.1:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Google Gemini, as an alternative or fallback provider.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# --- Datei-Zeitstempel (module #4) -------------------------------------------
# Every exiftool -overwrite_original write (GPS Sidecar's, AI Description's) bumps the
# touched file's filesystem mtime to "now". Timestamp & Rename, GPS Sidecar and AI
# Description all offer a "🕒 Datei-Zeitstempel wiederherstellen" button on their results
# screen to fix that for the batch just written. Set this to true/1/yes/on to have that
# happen automatically right after every "Ausführen" in all three modules instead of
# needing the button click -- same restore logic (filename pattern, EXIF/QuickTime
# fallback) as module #4's own standalone folder-wide scan. Leave unset/false to keep the
# manual button (the default).
RESTORE_TIMESTAMP=false

# IANA zone Datei-Zeitstempel interprets filenames/current mtimes as (e.g. "12:11:17" in a
# filename means 12:11:17 in THIS zone) -- independent of the container's own system
# timezone, which defaults to UTC with no TZ/tzdata configured (the stock
# python:3.13-slim image this project builds from). Only needs changing if your files'
# encoded timestamps are in a different real-world locale than Vienna.
MTIME_TIMEZONE=Europe/Vienna

# --- Collage module (module #5) ----------------------------------------------
# Standard settings for the "trip based" photo-pile collage generator -- every one of
# these is still a plain, overrideable form field on the Collage module page itself for
# a single run; this is just where the maintainer's own everyday defaults live, mirroring his
# actual photo_pile_collage.sh invocation:
#   ~/photo_pile_collage.sh "$IMGPFADJAHRURLAUB" --width 4096 --height 2304 --count 139
#   --border 6 --layout random --recursive --rotation 25
# (there's no separate --recursive switch here: the module always tries trip-folder
# auto-discovery first and falls back to treating Pfad as a single trip folder itself
# when nothing is found below it, exactly like the CLI's own --recursive fallback).
COLLAGE_LAYOUT=random
COLLAGE_WIDTH=4096
COLLAGE_HEIGHT=2304
COLLAGE_COUNT=139
COLLAGE_BORDER=6
COLLAGE_ROTATION=25
# Leave these three unset to keep the script's own auto-sizing/defaults:
COLLAGE_CELL=
COLLAGE_JITTER=0.55
COLLAGE_SEED=
COLLAGE_SPACING=0
COLLAGE_TILE_SIZE=
COLLAGE_SIZE_VARIATION=0.35
COLLAGE_SYNC_FOLDER_JPG=false

# Base photo-library path a generated collage is mirrored FROM, and the corresponding
# Home-Video path it's mirrored TO (e.g. <PHOTO_ROOT>/Urlaube/2026/Foo also gets its
# collage copied to <VIDEO_ROOT>/Urlaube/2026/Foo.jpg) -- same env vars the CLI script
# already reads. Mirroring is skipped for any folder not actually under PHOTO_ROOT, for
# any year/trip folder that doesn't already exist on the video side (never creates
# folders there), and for an existing destination file unless "überschreiben" is
# checked. Set VIDEO_ROOT= (empty) to disable mirroring entirely.
PHOTO_ROOT=/mnt/NAS/photo
VIDEO_ROOT=/mnt/NAS/video/Home-Video

# --- NFO Maker module (module #6) --------------------------------------------
# Kodi .nfo + poster/fanart/thumb/folder.jpg generator for videos, ported from
# HomeVideo_NFO_Maker_new.sh. READ-ONLY for GPS/location and AI-description data: it
# only ever reads what's already in a video's .xmp sidecar (run the GPS Sidecar / AI
# Beschreibung modules first for that) -- it never fetches a geo sidecar or calls an AI
# provider itself. Every value below matches the CLI script's own hardcoded defaults,
# so an unconfigured container behaves exactly like it did.
NFO_DIRECTOR=Your Name
NFO_STUDIO=Your Studio
NFO_SET=Home Movie
NFO_GENRE=Home-Video
NFO_TAG=Home-Video
NFO_MPAA=Rated R
NFO_CERTIFICATION=Germany:6
NFO_USERRATING=10
NFO_CRITICRATING=100
# Kodi skin [COLOR] name used for the "Ort: ..." location line in the plot.
NFO_GEO_COLOR=cyan
# Kodi-side (not container-side) path to the "CAMERA" actor's thumbnail image --
# always literal, since it's read by Kodi itself, not by this container.
NFO_CAMERA_THUMB=/storage/videos/HomeVideo/.actors/camera.png
# The <actor> list every generated .nfo gets (besides the dynamic "CAMERA" one above).
# Format: actors separated by ";", each actor's Name|Role|Thumb-path separated by "|"
# (not "," -- Role commonly contains commas itself, e.g. "Anna, Papa, Cameraman,
# Director"). Leave unset for no <actor> entries besides the CAMERA one. Example:
# NFO_ACTORS=Anna Beispiel|Anna, Papa, Cameraman, Director|/storage/videos/HomeVideo/.actors/Anna_Beispiel.jpg;Berta Beispiel|Berta, Mama, Camerawoman|/storage/videos/HomeVideo/.actors/Berta_Beispiel.jpg;Familie|Familie|/storage/videos/HomeVideo/.actors/family.jpg
# Default for the "AI-Beschreibung in den Plot übernehmen" checkbox (still
# overrideable per run on the module page) -- whether an AI description already
# sitting in a video's .xmp sidecar gets embedded in the plot. true/false.
NFO_AI_DESCRIPTION=true
# Default for the "-L/--nolocation" checkbox: skip reading the .xmp sidecar for
# GPS/location entirely (no "Ort: ..." line at all), still overrideable per run.
NFO_SKIP_LOCATION=false
# Default for -O/--older: protects a .nfo modified within the last N days from being
# regenerated even with "überschreiben" ticked, where N is 0 or negative (e.g. -7 =
# protect anything touched in the last week). Leave empty for no protection (default).
NFO_OLDER=
# Threshold (in seconds) for the "sehr kurze Videos" filter and the short-clip delete
# button on the scan list: a video counts as "short" when its duration is strictly
# below this value. The delete button always re-checks this threshold itself right
# before removing anything (see README), so changing this never makes an already
# borderline video delete-able without a fresh scan.
NFO_SHORT_VIDEO_SECS=10

# Optional own device names ("SM-S921B" -> "Samsung Galaxy S24"), see
# config/camera_names.example.json. Beats NFO Maker's rules and the Google device list.
#CAMERA_NAMES_FILE=/config/camera_names.json

# GPS-Zeitstempel (UTC) immer vertrauen (Standard: bei 1-14h Abweichung zur Aufnahmezeit wird Uhrzeit behalten)
# GPS_UTC_TRUST=always

# --- Docker build pin: exiftool (build arg; see Dockerfile) --------------------------------------
# exiftool is built from the official GitHub tag; the build fails if the built version differs from the pin.
#EXIFTOOL_VERSION=13.59

# Version stamp shown on the Info page (normally set by your build script):
#APP_VERSION=
#GIT_COMMIT=
#GIT_BRANCH=

# --- Stepped loading ("Nächste N laden") -------------------------------------------------
# Files processed per step in every list module. 0 = no stepping (everything at once).
# Per-module overrides (empty = use BATCH_SIZE): TIMESTAMP, GPS, AI, NFO, MTIME, SHORTVIDEOS, GPSFILL
BATCH_SIZE=200
#BATCH_SIZE_AI=50
#BATCH_SIZE_GPS=
#BATCH_SIZE_TIMESTAMP=
#BATCH_SIZE_NFO=
#BATCH_SIZE_MTIME=
#BATCH_SIZE_SHORTVIDEOS=
#BATCH_SIZE_GPSFILL=

# --- exiftool pool -----------------------------------------------------------------------
# Number of long-running exiftool processes shared by all modules (each ~30-40 MB while alive,
# closed after EXIFTOOL_POOL_IDLE_SECS idle). 0 = start exiftool per call (slow, old behaviour).
EXIFTOOL_POOL_SIZE=6
#EXIFTOOL_POOL_IDLE_SECS=300

# --- Docker build pins (build args; see Dockerfile) -----------------------------------------
# ffmpeg/ffprobe and mediainfo are built from the official source tarballs; the build fails if the
# built version differs from the pin. Defaults live in docker-compose.yml.
#FFMPEG_VERSION=9.0.2
#MEDIAINFO_VERSION=26.10

# --- Geo-Service (second service in the SAME docker-compose.yml: see geo-service/README.md) ---
# One place for reverse geocoding (Photon -> Nominatim -> Pelias with a shared cache and a
# circuit breaker), GPS-track lookup and caption context. Leave GEO_SERVICE_URL empty and
# everything works exactly as before. When set, the suite asks the service first and only
# falls back to its own PHOTON_/NOMINATIM_/PELIAS_ chain while the service is DOWN.
# Default (compose): http://geo-service:8000 -- set to an empty value (GEO_SERVICE_URL=) to turn it off,
# or to another URL if you run the service elsewhere.
#GEO_SERVICE_URL=http://geo-service:8000
#GEO_SERVICE_TOKEN=
#GEO_SERVICE_TIMEOUT=8

# AI-Beschreibung: also tell the model the time of day, month, weather and trip name
# (e.g. "nachmittags im Oktober 2026; Regen bei 11 °C; Teil der Reise "Sri Lanka & Malediven"").
# Needs GEO_SERVICE_URL; weather additionally needs WEATHER_PROVIDER=open-meteo on the service.
#AI_CONTEXT=true   # compose default is true now (geo-service runs alongside); set false to switch off

# User/group BOTH containers (metadata-suite and geo-service) run as. Use the numeric IDs of the owner
# of your NAS media and of ./config and ./geo-data (`id <user>` on the host); the suite writes
# .xmp/.nfo/renames on the NAS and presets into ./config as this user.
PUID=1026
PGID=100

# How many context items (time of day, season, weather, trip name) the description may use: 1, 2, 3 ... or all.
# Rules stay in every case: only if it fits the picture, weather/time of day only outdoors, never invent anything.
#AI_CONTEXT_MAX=2

# Length of a description. Without extra context (as the original script) / with context passed. More context
# gets a somewhat larger but still fixed budget, so it can never crowd out the description of the scene itself.
#AI_SENTENCES=2-3
#AI_WORDS_MAX=50
#AI_SENTENCES_CONTEXT=3-4
#AI_WORDS_MAX_CONTEXT=75

#XMP_CONTEXT=true   # Tageszeit/Jahreszeit/Wetter/Reisename zusätzlich als XMP-mon:Ctx*-Felder ins Sidecar (unabhängig vom KI-Text)

# Time zone of the container itself (IANA name). Affects everything that uses "local time" without an explicit
# zone: log lines, the "Info" page clock, NFO dates (file mtime -> year/premiered), exiftool-written local times.
# Empty/unset = UTC. Needs a rebuild once (tzdata is installed in the image), then just `docker compose up -d`.
# TZ=Europe/Vienna

# GeoNames-compatible API (replaces the old geonames-wrapper container; /findNearbyPlaceNameJSON,
# /search, /get, /hierarchy, /countryInfo, /address, /postalCodeSearch, ...). Token = GEO_SERVICE_TOKEN.
#GN_HTTP_TIMEOUT=10
#GN_MAX_ROWS_LIMIT=50
#GN_POSTAL_PROBE_RINGS=2
#GN_POSTAL_PROBE_POINTS_PER_RING=8
#GN_POSTAL_PROBE_CONCURRENCY=6
#GN_CHILDREN_MAX_PROBES=400         # geo-service childrenJSON: max. Nominatim-Abfragen pro Aufruf (danach "complete": false)
#GN_SEARCH_ORDER=gazetteer,pelias,nominatim,photon
#GN_COUNTRY_INFO_FILE=/geonames/countryInfo.txt   # GeoNames' countryInfo.txt inside the GeoNames volume (GEONAMES_HOST_DIR); no copy is shipped in the image
# Old geonames-wrapper names still work as fallbacks (GN_* wins): HTTP_TIMEOUT_SECONDS,
# MAX_ROWS_LIMIT, POSTAL_PROBE_RINGS, POSTAL_PROBE_POINTS_PER_RING, POSTAL_PROBE_CONCURRENCY,
# SEARCH_BACKEND_ORDER. NOMINATIM_DB_DSN is no longer needed.

# --- Geo-Service: container settings (ONE .env for both services) ----------------------------
# Everything below is read by the `geo-service` container of this docker-compose.yml. Shared
# variables (PHOTON_/NOMINATIM_/PELIAS_/MARITIME_SERVER, GEO_LANG, TRACCAR_*, DAWARICH_*,
# GEO_MAX_GAP_SECS*, GEO_SERVICE_TOKEN) are defined once above/below and used by BOTH services.
# Reverse-geocoder chain and resilience (GEO_CHAIN may also contain 'maritime', e.g. photon,nominatim,gazetteer,maritime,pelias; without it the maritime server is asked last):
#GEO_CHAIN=photon,nominatim,pelias,gazetteer
#GEO_HTTP_TIMEOUT=5
#GEO_BREAKER_FAILURES=3      # failures in a row before a backend is skipped ...
#GEO_BREAKER_COOLDOWN=60     # ... for this many seconds
# Cache (./geo-data/geo-cache.sqlite):
#GEO_CACHE_PRECISION=4       # decimals of lat/lon used as cache key (4 = ~11 m)
#GEO_CACHE_TTL_DAYS=365
#GEO_CACHE_NEG_TTL=3600      # seconds a "nothing found" answer is remembered
# Weather: none | open-meteo   (history is archived in the cache; see geo-service/README.md)
#WEATHER_PROVIDER=none
#WEATHER_BACKFILL_DELAY=0.4  # seconds between backfill requests
#WEATHER_BACKFILL_MAX=5000   # max. points per backfill run
# Time zone for local time-of-day when a file carries no zone:
#GEO_DEFAULT_TZ=Europe/Vienna

# Height above sea level (CtxElevation in the sidecar, /elevation, GeoNames srtm3/astergdem/gtopo30):
# override -> cache -> local SRTM3 tiles (./geo-data/srtm/N47E016.hgt) -> Open-Meteo. Comma list, order = priority;
# "none" switches heights off. The tiles for Austria (27 files, ~78 MB) are fetched once in the background at start.
#ELEVATION_PROVIDER=local,open-meteo
#GEO_SRTM_PRELOAD=austria     # comma list, e.g. austria,germany,italy,croatia,slovenia,sri_lanka,maldives (more: switzerland czechia slovakia hungary poland france spain portugal greece bosnia serbia romania bulgaria netherlands belgium uk ireland denmark sweden norway finland turkey; 'europe' = several GB!). Unknown names are logged and ignored. empty/none = download nothing; other areas: sh geo-service/tools/fetch_srtm.sh --bbox ...

# Hand-made corrections laid over cache + geocoders (see geo-service/overrides.example.json); default ./geo-data/overrides.json
#GEO_OVERRIDES_FILE=

#AI_CONTEXT_ELEVATION=false   # auch die Seehöhe ('auf ca. 1200 m Seehöhe') an das Modell geben (XMP CtxElevation steht immer im Sidecar)

# GPS Sidecar / GPS Fill add what is missing next to the position: altitude (XMP-exif:GPSAltitude, taken from the file's own
# EXIF if it has one, else from the geo-service) and the time zone (XMP-mon:CtxTimezone). Embedding into the image
# (AI-Beschreibung / 'ins Bild einbetten') then also writes GPSAltitude into the image if it has none.
#XMP_PLACE_EXTRAS=true

# Also write EXIF OffsetTimeOriginal from the time zone into images that have none (only when the image has a
# DateTimeOriginal). Assumes the camera clock shows LOCAL time at the place of the shot. false = switch off.
#IMAGE_OFFSET_FROM_ZONE=true

# IPTC "Credits/Origin" of photos (IrfanView: Date created / Source / Credits), filled ONLY where empty, never overwritten:
# Date created from the capture time, Source = mapped camera name (camera_names.json), Credits = IPTC_CREDIT.
# The XMP twins (photoshop:DateCreated/Source/Credit) also go into the sidecar, so videos get them too.
#IPTC_FILL=true
#IPTC_CREDIT=Familie Beispiel      # empty value = write no credit

# Nominatim-/Photon-compatible ports for Traccar and Dawarich (host ports 8431 / 8432, see compose).
# Answers come from cache + your Nominatim/Photon/Pelias + the overrides. Open by default (location lookups
# only); GEO_COMPAT_AUTH=true asks for GEO_SERVICE_TOKEN as ?token= / ?key= / X-Api-Key. 0 = switch a port off.
#GEO_NOMINATIM_PORT=8001
#GEO_PHOTON_PORT=8002
#GEO_COMPAT_AUTH=false

# --- Volumes: ALL host paths of the container mappings live here (left side of the ":" in compose) ------
# Container paths are fixed, only the host side changes. Relative paths are relative to docker-compose.yml.
MEDIA_HOST_DIR=/mnt/NAS            # your photo/video share -> mounted at MEDIA_ROOT inside the suite container
CONFIG_HOST_DIR=./config           # presets.json, camera_names.json (suite, writable)
GEO_DATA_HOST_DIR=./geo-data       # geo-service: cache, overrides.json, SRTM tiles (writable)
GEONAMES_HOST_DIR=./geonames       # geo-service: folder with your GeoNames files, mounted read-only at /geonames
                                   #   (countryInfo.txt is read from there; nothing GeoNames-related is shipped in the image)

# Map in the override editor (your tileserver-GL, raster tiles; the BROWSER must reach this URL):
#GEO_TILE_URL=http://192.168.1.33:8777/styles/protomaps-light/{z}/{x}/{y}.png
#GEO_TILE_ATTRIBUTION=© OpenStreetMap · Protomaps
#GEO_TILE_MAXZOOM=19

# Kontext-Extras: Heimat (Länderinfo erscheint nur im Ausland), Reise-Erkennung, Sehenswürdigkeiten, Ortsnamen
#GEO_HOME_COUNTRY=AT              # ISO-2; Länderinfo (Hauptstadt, Währung, Sprachen) nur außerhalb
#GEO_HOME_LAT=                    # Zuhause (sonst: Ort der Art 'Zuhause' in Meine Orte, sonst: wo du nachts am häufigsten bist)
#GEO_HOME_LON=
#GEO_TRIP_AWAY_KM=60              # ab dieser Entfernung vom Zuhause zählt ein Tag als 'unterwegs'
#GEO_TRIP_MIN_DAYS=2              # kürzer ist keine Reise
#GEO_TRIP_MAX_GAP_DAYS=1          # Tage zu Hause, die eine Reise nicht beenden
#GEO_TRIP_LOOKBACK_DAYS=45        # so weit schaut die Erkennung um einen Zeitpunkt herum
#GEO_POI=true                     # Sehenswürdigkeiten in der Nähe (über PHOTON_SERVER) + deine Orte mit Häkchen
#GEO_POI_RADIUS_M=400
#GEO_POI_MAX=3
#GEO_NORMALIZE_NAMES=true         # 'Marktgemeinde Musterdorf' -> 'Musterdorf', 'Politischer Bezirk Baden' -> 'Bezirk Baden'
#GEO_NAME_ALIASES_FILE=           # eigene Schreibweisen (JSON), Standard: place-names.json im Datenordner

# Welche Zusatz-Angaben des Services in den KI-Prompt dürfen (in den XMP-Feldern stehen immer alle): daylight (goldene/blaue
# Stunde), moon (nur auffällige Phasen), holiday, trip (automatisch aus dem GPS-Verlauf erkannt), poi (Sehenswürdigkeiten),
# wind, precip, country (Hauptstadt/Währung/Sprachen im Ausland). Komma-Liste, all oder none.
#AI_CONTEXT_EXTRAS=daylight,moon,holiday,trip,poi

# NFO-Plot: full = Wetter, Wind, Regen, Licht, Mond, Feiertag, Reise, Sehenswürdigkeiten, Länderinfo; basic = nur Temp/Wetter; off
#NFO_PLOT_CONTEXT=full

# --- Nachgetragen (Abgleich Code <-> .env.example), neue Einträge immer am Ende ------------------------------
#GPS_TRACK_BRIDGE_DAYS=3          # Aufnahmetage mit höchstens so vielen Tagen Abstand teilen sich EINEN Track-Abruf
#GPS_TRACK_MAX_SPAN_DAYS=31       # längster Zeitraum pro Track-Abruf (länger = mehrere Abrufe)
#XMP_EE_MAX_MB=100                # exiftool -ee (alle Videoframes lesen) nur bis zu dieser Dateigröße; größere schneller (-fast2)
#XMP_TIMEOUT_MAX=1800             # Höchst-Timeout (s) für das Lesen großer Videos (60 s + 0,25 s/MB)
#GEO_TRACK_TIMEOUT=60             # geo-service: Timeout (s) je Abruf bei Traccar/Dawarich
#WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive   # geo-service: Open-Meteo-Archiv (z. B. eigener Spiegel)
#WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast         # geo-service: Open-Meteo-Vorhersage
#ELEVATION_URL=https://api.open-meteo.com/v1/elevation               # geo-service: Höhen-API, wenn keine lokalen SRTM-Kacheln da sind
#GEO_SRTM_SOURCE_URL=https://elevation-tiles-prod.s3.amazonaws.com/skadi   # geo-service: Quelle der SRTM-Kacheln (fetch_srtm / GEO_SRTM_PRELOAD)
#GN_ID_DB=                        # geo-service: Datei der synthetischen geonameIds (Standard: geonames-ids.sqlite neben dem Cache)
# Alte Namen aus dem früheren GeoNames-Wrapper gelten weiter als Ersatz für die GN_*-Variablen:
#SEARCH_BACKEND_ORDER=gazetteer,pelias,nominatim,photon   # = GN_SEARCH_ORDER
#MAX_ROWS_LIMIT=50                # = GN_MAX_ROWS_LIMIT
#POSTAL_PROBE_RINGS=2             # = GN_POSTAL_PROBE_RINGS
#POSTAL_PROBE_POINTS_PER_RING=8   # = GN_POSTAL_PROBE_POINTS_PER_RING
#POSTAL_PROBE_CONCURRENCY=6       # = GN_POSTAL_PROBE_CONCURRENCY
#HTTP_TIMEOUT_SECONDS=10          # = GN_HTTP_TIMEOUT
# Nur beim Bauen (Build-Argument, keine .env-Variable): BUILD_DATE / GIT_COMMIT -- siehe Dockerfile.

# Android-Geräteliste (Modellcode -> Name, z. B. SM-S921B -> Galaxy S24): liegt NICHT im Image, sondern im Config-Ordner.
# Einmal holen bzw. später aktualisieren (Container braucht dafür Internet):
#   docker compose exec metadata-suite python -m app.core.devicenames update
#ANDROID_DEVICES_FILE=/config/android_devices.json

# Endpunkt-Seite (🔗 links neben Info): die Links gehen direkt vom Browser zum geo-service. Leer = der Host, mit dem du die Suite geöffnet hast;
# Ports = die Host-Ports aus der docker-compose.yml (8430 API, 8431 Nominatim, 8432 Photon).
#GEO_SERVICE_PUBLIC_URL=http://192.168.1.33
#GEO_PUBLIC_PORT=8430
#GEO_PUBLIC_PORT_NOMINATIM=8431
#GEO_PUBLIC_PORT_PHOTON=8432

# Module "Kontext nachfüllen": files per step (default: BATCH_SIZE)
#BATCH_SIZE_CTXFILL=

# Timeout (s) for the geo-service's /context only (Kontext nachfüllen, AI description). The first call per place and day is slow
# (Open-Meteo, sights, trip detection); with GEO_SERVICE_TIMEOUT=8 it failed although the service cached the result afterwards.
#GEO_CONTEXT_TIMEOUT=40

# Sights: extra OSM historic=* values that are NOT sights (comma list), on top of the built-in skip list
# (memorial/Gedenktafel, plaque, tomb, wayside cross/shrine, boundary stone, generic historic building ...).
#GEO_POI_SKIP=

# Commit comment shown on the Info page (set by build_start.sh):
#GIT_MESSAGE=

# Jahreslauf: a step that found nothing left to do is skipped on the next run while its folder is unchanged and the
# result is younger than this many days (default 30; 0 = always check everything). Tick "Alles neu prüfen" to force a full check once.
#YEAR_RUN_STATE_DAYS=

# Gazetteer (eigene GeoNames-Datenbank, ersetzt Pelias):
#GN_GAZETTEER_DB=                  # eigene GeoNames-Datenbank (Standard: gazetteer.sqlite neben dem Cache); bauen: docker compose exec geo-service python -m app.gazetteer
#GN_GAZETTEER_LANGS=de,en          # Sprachen der alternativen Namen, die beim Import behalten werden
#GN_GAZETTEER_FTS_CLASSES=         # Suchindex nur für diese Klassen (leer = alle), z. B. A,P,T,H,L,V
#GN_GAZETTEER_REVERSE_KM=25        # /reverse über die eigene Datenbank: nächster Ort höchstens so weit entfernt
#GN_DUMP_DIR=                      # Ordner der GeoNames-Dumps (Standard: Ordner von GN_COUNTRY_INFO_FILE, also /geonames)

# Zeitprotokoll: jede Anfrage, die länger dauert als so viele Millisekunden, wird mit Zeitstempel (ms) ins Docker-Log geschrieben (0 = alle, -1 = aus):
#GEO_SLOW_LOG_MS=500

# Sehenswürdigkeiten-Index (optional, Schritt für /sights): eigene Datenbank aus der Planet-Datei deines Nominatim, nur lesend.
# Bauen:  docker compose --profile import build sights-import   dann   docker compose --profile import run --rm sights-import all
# Ohne die Datenbank nutzt /sights weiter deinen Photon.
#GEO_OSM_PBF_HOST_DIR=/mnt/ssd/nominatim-planet/data   # Ordner mit planet-latest.osm.pbf (wird schreibgeschützt eingebunden)
#GEO_OSM_PBF_FILE=/osm/planet-latest.osm.pbf              # Dateiname im Container
#GEO_SIGHTS_DB=                                           # Standard: sights.sqlite neben dem Cache (GEO_DATA_HOST_DIR)
#GEO_SIGHTS_WORK_DIR=                                     # Zwischendateien beim Bauen (Standard: sights-work/ neben der Datenbank, einige GB)
#GEO_SIGHTS_OSMIUM_INDEX=flex_mem                         # osmium-Ortsindex (flex_mem = Arbeitsspeicher; sparse_file_array,/pfad bei wenig RAM)
#GEO_SIGHTS_WD_DELAY=1.0                                  # Sekunden Pause zwischen zwei Wikidata-Abfragen (50 Objekte je Abfrage)
#GEO_SIGHTS_WD_WORKERS=2                                # Import-Container: gleichzeitige Wikidata-Abfragen (Standard 2; 1 = am schonendsten)
#GEO_TILE_PROXY=true                                     # Karte (Editor, /nearby) ueber /tiles/{z}/{x}/{y} dieses Dienstes laden: noetig, wenn die Seite per HTTPS laeuft und GEO_TILE_URL http://... ist (Mixed Content) oder das Handy den Tileserver nicht direkt erreicht
#GEO_WIKIMEDIA_HOST_DIR=/mnt/ssd/nominatim-planet               # Ordner mit wikimedia-importance.sql.gz (Nominatim), wird schreibgeschuetzt gemountet
#GEO_WIKIMEDIA_IMPORTANCE_FILE=/wikimedia/wikimedia-importance.sql.gz   # Dateiname im Container (.sql.gz oder .csv.gz)
#GEO_SIGHTS_WD_MAXLAG=0                                  # Import-Container: 0 = aus (Standard). >0 = Wikidata-Abfragen warten, solange dessen Replikationsverzoegerung ueber so vielen Sekunden liegt (5 ist oft dauerhaft ueberschritten)
#GEO_SIGHTS_WD_CONTACT=                                  # Import-Container: deine E-Mail oder URL; steht im User-Agent der Wikidata-Abfragen (Wikimedia-Empfehlung, optional)
#GEO_SIGHTS_TR_SCOPE=notable                             # Import-Container, Befehl translate: notable = nur Sehenswuerdigkeiten mit Wikimedia-Wichtigkeit/Sitelinks (Standard), all = alle ohne deutsche Beschreibung
#GEO_SIGHTS_TR_MAX=0                                     # Import-Container, translate: hoechstens so viele Eintraege pro Lauf (0 = alle; zum Testen z.B. 20)
#GEO_SIGHTS_TR_SLEEP=0                                   # Import-Container, translate: Pause in Sekunden zwischen zwei Anfragen (Google-Free-Tier: z.B. 4)
#GEO_SIGHTS_TR_TIMEOUT=60                                # Import-Container, translate: Sekunden je Anfrage an Ollama/Google
#GEO_SIGHTS_TR_RETRY=0                                   # Import-Container, translate: 1 = auch Eintraege erneut fragen, die das Modell mit UNKNOWN beantwortet hat; only = NUR diese (nicht die noch nie gefragten)
#OLLAMA_MODEL_TEXT=qwen2.5:7b-instruct                   # Import-Container, translate: Textmodell fuer die Uebersetzung der Beschreibungen (leer = OLLAMA_MODEL, das ist meist das Bildmodell)
#GOOGLE_AI_MODEL_TEXT=                                   # Import-Container, translate: Google-Textmodell (leer = GOOGLE_AI_MODEL)
#GEO_SIGHTS_TR_LOG=1                                     # Import-Container, translate: 1 = je Eintrag eine Logzeile (Originaltext -> Uebersetzung bzw. Ablehnungsgrund, Standard), 0 = nur Fortschritt alle 50
#GEO_SIGHTS_TR_BATCH=10                                  # Import-Container, translate: Beschreibungen je Anfrage an das Modell (1 = einzeln; abgelehnte Eintraege werden danach einzeln erneut gefragt)
#GEO_SIGHTS_TR_WORKERS=2                                 # Import-Container, translate: gleichzeitige Anfragen (Ollama: OLLAMA_NUM_PARALLEL beachten)
#GEO_TOP_SIGHT_M=60                                      # geo-service: liegt eine wichtige Sehenswürdigkeit innerhalb so vieler Meter, gilt sie als das Motiv (Feld CtxSight, Ort-Zeile der .nfo); 0 = aus
#GEO_TOP_SIGHT_MIN_IMPORTANCE=0.30                       # geo-service: ab welcher Wikimedia-Wichtigkeit (0..1) eine nahe Sehenswürdigkeit als Motiv gilt (eigene Orte immer)
#GEO_SIGHTS_WP_SCOPE=notable                             # Import-Container, Befehl wikitext: notable = nur Sehenswürdigkeiten mit Wikimedia-Wichtigkeit, all = alle mit Wikipedia-Artikel
#GEO_SIGHTS_WP_LANGS=de,en                               # Import-Container, wikitext: Sprachen der Wikipedia-Kurztexte
#GEO_SIGHTS_WP_MAX=0                                     # Import-Container, wikitext: höchstens so viele Artikel pro Lauf (0 = alle)
#GEO_SIGHTS_WP_DELAY=0.5                                 # Import-Container, wikitext: Sekunden Pause zwischen zwei Abfragen (20 Artikel je Abfrage)
#GEO_SIGHTS_WP_WORKERS=2                                 # Import-Container, wikitext: gleichzeitige Abfragen
#GEO_SIGHTS_WP_SENTENCES=3                               # Import-Container, wikitext: höchstens so viele Sätze aus dem Artikelanfang
#GEO_SIGHTS_WP_MAXCHARS=400                              # Import-Container, wikitext: Kurztext höchstens so lang (Satzende bevorzugt)
#GEO_SIGHTS_REFRESH_DAYS=0                               # Automatische Aktualisierung des Sehenswürdigkeiten-Index: alle so viele Tage (0 = aus). Dienst sights-refresh (Profil refresh)
#GEO_SIGHTS_REFRESH_AT=03:30                             # Automatische Aktualisierung: Uhrzeit (HH:MM, Zeitzone des Containers/TZ)
#GEO_SIGHTS_IMPORTANCE_URL=https://downloads.opencagedata.com/public/wikimedia_importance/%YYYYMM%/wikimedia_importance.tsv.gz,https://nominatim.org/data/wikimedia-importance.csv.gz                      # Automatische Aktualisierung: Wikimedia-Importance-Datei, mehrere Adressen mit Komma getrennt (geladen wird die mit dem neuesten Datum; off = nicht laden)
#GEO_SIGHTS_PBF_URL=                                     # Automatische Aktualisierung: Download der Planet-PBF (z.B. https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf, ca. 85 GB); leer = die vorhandene GEO_OSM_PBF_FILE (Nominatim) nutzen
#GEO_DOWNLOAD_HOST_DIR=./downloads                       # Nur compose: Host-Ordner für heruntergeladene Quelldateien (nach /downloads; behalten werden die neueste und die letzte erfolgreich genutzte Version)
#GEO_SIGHTS_REFRESH_WIKITEXT=1                           # Automatische Aktualisierung: auch Wikipedia-Kurztexte holen (0 = nicht)
#GEO_SIGHTS_REFRESH_TRANSLATE=1                          # Automatische Aktualisierung: auch Beschreibungen per LLM übersetzen (braucht AI_PROVIDER; 0 = nicht)
#GEO_SIGHTS_REFRESH_FORCE_BUILD=0                        # Automatische Aktualisierung: 1 = den Index in jedem Lauf neu bauen, auch wenn die PBF gleich ist
#GEO_SIGHTS_KEEP_PREV=1                                  # Beim Neuaufbau die bisherige sights.sqlite als sights.sqlite.prev behalten (Hardlink, kostet keinen Platz zusätzlich; 0 = nicht)
#GEO_PLACE_TRIP_KM=100                                  # Ohne Ordner- und Track-Reise: weiter als so viele km von Zuhause entfernt heißt die Reise Ort und Umgebung (z. B. Triest und Umgebung; 0 = aus; braucht GEO_HOME_LAT/LON oder einen Ort der Art Zuhause)
#GEO_WIKIMEDIA_BUILD_DAYS=30                             # Container wikimedia-build (Profil wikimedia): wikimedia_importance.tsv.gz selbst erzeugen, alle so viele Tage (0 = nur auf Befehl: run --rm wikimedia-build once)
#GEO_WIKIMEDIA_BUILD_AT=03:00                            # wikimedia-build: Uhrzeit des Monatslaufs
#GEO_WIKIMEDIA_LANGUAGES=                                # wikimedia-build: Sprachen, z. B. de,en für einen kleinen schnellen Lauf (leer = alle 39, 9-12 Stunden, ca. 150 GB)
#GEO_WIKIMEDIA_KEEP=2                                    # wikimedia-build: so viele datierte Ergebnisdateien behalten (neueste + die davor)
#GEO_WIKIMEDIA_KEEP_WORK=0                               # wikimedia-build: 1 = Downloads und Datenbank nach einem guten Lauf behalten
#GEO_WIKIMEDIA_WORK_HOST_DIR=./wikimedia-work            # Nur compose: Host-Ordner für Downloads und CSVs von wikimedia-build (ca. 60 GB)
#GEO_WIKIMEDIA_PGDATA_HOST_DIR=./wikimedia-pgdata        # Nur compose: Host-Ordner für die PostgreSQL-Daten von wikimedia-build (ca. 90 GB, am besten NVMe)
#GEO_SIGHTS_TR_LEN_FACTOR=4                              # translate: eine Uebersetzung gilt als zu lang ab Faktor x Laenge des Originals (chinesisch/japanisch/koreanisch: 1,5 x Faktor)
#GEO_SIGHTS_TR_LEN_MIN=200                              # translate: bis zu dieser Zeichenzahl ist jede Antwort lang genug (kurze Quellen)
#GEO_RADAR_STYLE_URL=                                    # /radar: MapLibre-Stil deines tileserver-GL, z. B. http://192.168.1.33:8777/styles/streets/style.json (leer = aus GEO_TILE_URL abgeleitet)
#GEO_RADAR_API=https://api.rainviewer.com/public/weather-maps.json   # /radar: Radarquelle (RainViewer-kompatibel, z. B. eigener LibreWXR: http://<host>:8080/public/weather-maps.json)
#GEO_RADAR_COLOR=2                                       # /radar: Farbschema-ID der Kacheln (2 = Universal Blue)
#GEO_RADAR_OPTIONS=1_0                                   # /radar: smooth_snow der Kachel-URL (1_0 = geglaettet, ohne Schneefarben)
#GEO_RADAR_MAXZOOM=7                                     # /radar: hoechste Zoomstufe der Radarkacheln (RainViewer: 7; darueber wird vergroessert)
#MEDIA_IMAGE_DIR=./media-images                          # Nur Host-Skript (ensure_media_image.sh/build_start.sh): Ordner mit der tar-Kopie des ffmpeg/mediainfo-Images - am besten auf der NVMe; nach `docker image prune -a` wird daraus geladen statt neu kompiliert
#FILE_INDEX=on                                           # SQLite-Index (config/file_index.sqlite) vor den Scans von Kontext und KI-Beschreibung + Lauf-Protokoll des Jahreslaufs; off = alles direkt aus den Dateien lesen (die Datei bleibt immer der Master)
#FILE_INDEX_DAYS=365                                     # Einträge des Index gelten so viele Tage, danach wird die Datei wieder gelesen (0 = Index nie verwenden)
#FILE_INDEX_DB=                                          # Pfad der SQLite-Datei des Index (leer = /config/file_index.sqlite, neben presets.json)
