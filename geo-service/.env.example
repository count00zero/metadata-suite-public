# cp .env.example .env   -- docker compose reads it automatically. Do NOT quote values.
# The variable names are the metadata-suite's own, so you can paste that block in unchanged.
#
# ORDER OF THIS FILE: oldest entry first, newest last. New settings are always appended at the END
# (never inserted in the middle).

# --- reverse geocoding ---------------------------------------------------------------------
PHOTON_SERVER=http://192.168.1.33:2322
NOMINATIM_SERVER=http://192.168.1.33:4241
PELIAS_SERVER=http://192.168.1.33:4000
# Last resort for open water, only asked when all of the above found nothing:
MARITIME_SERVER=http://192.168.1.33:5002
GEO_LANG=de
# Order in which the geocoders are tried (the suite's order). 'maritime' may be listed too (e.g. photon,nominatim,gazetteer,maritime,pelias);
# if it is not, the maritime server is asked last.
GEO_CHAIN=photon,nominatim,pelias,gazetteer
GEO_HTTP_TIMEOUT=5
# A backend that is unreachable / answers 5xx this many times in a row is skipped for the cooldown (s):
GEO_BREAKER_FAILURES=3
GEO_BREAKER_COOLDOWN=60

# --- cache -----------------------------------------------------------------------------------
# Decimals of lat/lon in the cache key: 4 = ~11 m (same cell = same answer), 3 = ~110 m.
GEO_CACHE_PRECISION=4
GEO_CACHE_TTL_DAYS=365
# "no place found here" is only remembered this long (s); an outage is never remembered.
GEO_CACHE_NEG_TTL=3600

# --- GPS tracks (for /track-at, /track-range and gps_fill.py) ------------------------------------
TRACCAR_URL=http://192.168.1.1:8082
TRACCAR_TOKEN=
TRACCAR_DEVICES=7:Phone A - Traccar,19:Phone A - gpslogger
TRACCAR_DEVICES_ADDITIONAL=8:Work phone - HA,11:Phone B - HA
DAWARICH_SERVER=http://192.168.1.33:3000
DAWARICH_API_KEY=
# The archive account holds points derived from photos' own GPS -- only ever used with include_import=true.
DAWARICH_IMPORT_API_KEY=
GEO_MAX_GAP_SECS=600
GEO_MAX_GAP_SECS_TIER2=21600

# --- caption context -------------------------------------------------------------------------------
# open-meteo: historical weather for AI captions. Coordinates are rounded to 0.1 degrees (~11 km) before
# they leave your network, one request per place and day, cached. none = nothing is ever sent anywhere.
WEATHER_PROVIDER=none
# Weather archive ("shadow database"): finished days are stored permanently; POST /weather/backfill (or the
# "Wetter-Archiv" box in the suite's GPS füllen module) fills it ahead of time. Pause between Open-Meteo requests
# and the maximum number of requests per run (free tier: 600/minute, 10 000/day):
#WEATHER_BACKFILL_DELAY=0.4
#WEATHER_BACKFILL_MAX=5000
GEO_DEFAULT_TZ=Europe/Vienna

# --- access ---------------------------------------------------------------------------------------------
# If set, every endpoint except /health needs  X-API-Key: <token>  (or Authorization: Bearer <token>).
GEO_SERVICE_TOKEN=

# --- container user (unRAID: nobody:users) -------------------------------------------------------------------
PUID=1026
PGID=100

# --- GeoNames-compatible endpoints (replaces the geonames-wrapper container) -----------------------
# http://<geo-service>:8430/findNearbyPlaceNameJSON?lat=..&lng=..   and   /findNearbyPostalCodesJSON?lat=..&lng=..
# They use the NOMINATIM_SERVER / PELIAS_SERVER / PHOTON_SERVER above. The old wrapper's names
# (MAX_ROWS_LIMIT, POSTAL_PROBE_RINGS, POSTAL_PROBE_POINTS_PER_RING, POSTAL_PROBE_CONCURRENCY,
# HTTP_TIMEOUT_SECONDS) are accepted as fallbacks, so its .env values can be pasted in unchanged.
#GN_HTTP_TIMEOUT=10
#GN_MAX_ROWS_LIMIT=50
#GN_POSTAL_PROBE_RINGS=2
#GN_POSTAL_PROBE_POINTS_PER_RING=8
#GN_POSTAL_PROBE_CONCURRENCY=6
#GN_CHILDREN_MAX_PROBES=400         # childrenJSON: max. Nominatim lookups per call (then the list is marked incomplete)
# Order for search (first backend with an answer wins). countryInfo.txt is read from your GeoNames volume
# (GEONAMES_HOST_DIR -> /geonames); nothing GeoNames-related is shipped in the image.
#GN_SEARCH_ORDER=gazetteer,pelias,nominatim,photon
#GN_COUNTRY_INFO_FILE=/geonames/countryInfo.txt
# Old geonames-wrapper names still work as fallbacks (GN_* wins): HTTP_TIMEOUT_SECONDS, MAX_ROWS_LIMIT,
# POSTAL_PROBE_RINGS, POSTAL_PROBE_POINTS_PER_RING, POSTAL_PROBE_CONCURRENCY, SEARCH_BACKEND_ORDER.

# Height above sea level (CtxElevation in the sidecar, /elevation, GeoNames srtm3/astergdem/gtopo30):
# override -> cache -> local SRTM3 tiles (./geo-data/srtm/N47E016.hgt) -> Open-Meteo. Comma list, order = priority;
# "none" switches heights off. The tiles for Austria (27 files, ~78 MB) are fetched once in the background at start.
#ELEVATION_PROVIDER=local,open-meteo
#GEO_SRTM_PRELOAD=austria     # comma list, e.g. austria,germany,italy,croatia,slovenia,sri_lanka,maldives (more: switzerland czechia slovakia hungary poland france spain portugal greece bosnia serbia romania bulgaria netherlands belgium uk ireland denmark sweden norway finland turkey; 'europe' = several GB!). Unknown names are logged and ignored. empty/none = download nothing; other areas: sh geo-service/tools/fetch_srtm.sh --bbox ...
# Hand-made corrections laid over cache + geocoders (see geo-service/overrides.example.json); default ./geo-data/overrides.json
#GEO_OVERRIDES_FILE=

# Nominatim-/Photon-compatible ports for Traccar and Dawarich (host ports 8431 / 8432, see compose).
# Answers come from cache + your Nominatim/Photon/Pelias + the overrides. Open by default (location lookups
# only); GEO_COMPAT_AUTH=true asks for GEO_SERVICE_TOKEN as ?token= / ?key= / X-Api-Key. 0 = switch a port off.
#GEO_NOMINATIM_PORT=8001
#GEO_PHOTON_PORT=8002
#GEO_COMPAT_AUTH=false

# --- Volumes (host side of the mappings in docker-compose.yml) -----------------------------------------------
GEO_DATA_HOST_DIR=./data               # cache, overrides.json, SRTM tiles (writable)
GEONAMES_HOST_DIR=./geonames           # folder with your GeoNames files, mounted read-only at /geonames (countryInfo.txt)

# Map in the override editor (your tileserver-GL, raster tiles; the BROWSER must reach this URL):
#GEO_TILE_URL=http://192.168.1.33:8777/styles/protomaps-light/{z}/{x}/{y}.png
#GEO_TILE_ATTRIBUTION=© OpenStreetMap · Protomaps
#GEO_TILE_MAXZOOM=19

# Kontext-Extras: Heimat (Länderinfo erscheint nur im Ausland), Reise-Erkennung, Sehenswürdigkeiten, Ortsnamen
#GEO_HOME_COUNTRY=AT              # ISO-2; Länderinfo (Hauptstadt, Währung, Sprachen) nur außerhalb
#GEO_HOME_LAT=                    # Zuhause (sonst: Ort der Art 'Zuhause' in Meine Orte, sonst: wo du nachts am häufigsten bist)
#GEO_HOME_LON=
#GEO_TRIP_AWAY_KM=60              # ab dieser Entfernung vom Zuhause zählt ein Tag als 'unterwegs'
#GEO_TRIP_MIN_DAYS=2              # kürzer ist keine Reise
#GEO_TRIP_MAX_GAP_DAYS=1          # Tage zu Hause, die eine Reise nicht beenden
#GEO_TRIP_LOOKBACK_DAYS=45        # so weit schaut die Erkennung um einen Zeitpunkt herum
#GEO_POI=true                     # Sehenswürdigkeiten in der Nähe (über PHOTON_SERVER) + deine Orte mit Häkchen
#GEO_POI_RADIUS_M=400
#GEO_POI_MAX=3
#GEO_NORMALIZE_NAMES=true         # 'Marktgemeinde Musterdorf' -> 'Musterdorf', 'Politischer Bezirk Baden' -> 'Bezirk Baden'
#GEO_NAME_ALIASES_FILE=           # eigene Schreibweisen (JSON), Standard: place-names.json im Datenordner

# --- Nachgetragen (Abgleich Code <-> .env.example), neue Einträge immer am Ende ------------------------------
#GEO_TRACK_TIMEOUT=60             # geo-service: Timeout (s) je Abruf bei Traccar/Dawarich
#WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive   # geo-service: Open-Meteo-Archiv (z. B. eigener Spiegel)
#WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast         # geo-service: Open-Meteo-Vorhersage
#ELEVATION_URL=https://api.open-meteo.com/v1/elevation               # geo-service: Höhen-API, wenn keine lokalen SRTM-Kacheln da sind
#GEO_SRTM_SOURCE_URL=https://elevation-tiles-prod.s3.amazonaws.com/skadi   # geo-service: Quelle der SRTM-Kacheln (fetch_srtm / GEO_SRTM_PRELOAD)
#GN_ID_DB=                        # geo-service: Datei der synthetischen geonameIds (Standard: geonames-ids.sqlite neben dem Cache)
# Alte Namen aus dem früheren GeoNames-Wrapper gelten weiter als Ersatz für die GN_*-Variablen:
#SEARCH_BACKEND_ORDER=gazetteer,pelias,nominatim,photon   # = GN_SEARCH_ORDER
#MAX_ROWS_LIMIT=50                # = GN_MAX_ROWS_LIMIT
#POSTAL_PROBE_RINGS=2             # = GN_POSTAL_PROBE_RINGS
#POSTAL_PROBE_POINTS_PER_RING=8   # = GN_POSTAL_PROBE_POINTS_PER_RING
#POSTAL_PROBE_CONCURRENCY=6       # = GN_POSTAL_PROBE_CONCURRENCY
#HTTP_TIMEOUT_SECONDS=10          # = GN_HTTP_TIMEOUT

# Sights: extra OSM historic=* values that are NOT sights (comma list), on top of the built-in skip list
# (memorial/Gedenktafel, plaque, tomb, wayside cross/shrine, boundary stone, generic historic building ...).
#GEO_POI_SKIP=

# Gazetteer (eigene GeoNames-Datenbank, ersetzt Pelias):
#GN_GAZETTEER_DB=                  # eigene GeoNames-Datenbank (Standard: gazetteer.sqlite neben dem Cache); bauen: docker compose exec geo-service python -m app.gazetteer
#GN_GAZETTEER_LANGS=de,en          # Sprachen der alternativen Namen, die beim Import behalten werden
#GN_GAZETTEER_FTS_CLASSES=         # Suchindex nur für diese Klassen (leer = alle), z. B. A,P,T,H,L,V
#GN_GAZETTEER_REVERSE_KM=25        # /reverse über die eigene Datenbank: nächster Ort höchstens so weit entfernt
#GN_DUMP_DIR=                      # Ordner der GeoNames-Dumps (Standard: Ordner von GN_COUNTRY_INFO_FILE, also /geonames)

# Zeitprotokoll: jede Anfrage, die länger dauert als so viele Millisekunden, wird mit Zeitstempel (ms) ins Docker-Log geschrieben (0 = alle, -1 = aus):
#GEO_SLOW_LOG_MS=500

# Sehenswürdigkeiten-Index (optional, Schritt für /sights): eigene Datenbank aus der Planet-Datei deines Nominatim, nur lesend.
# Bauen:  docker compose --profile import build sights-import   dann   docker compose --profile import run --rm sights-import all
# Ohne die Datenbank nutzt /sights weiter deinen Photon.
#GEO_OSM_PBF_HOST_DIR=/mnt/ssd/nominatim-planet/data   # Ordner mit planet-latest.osm.pbf (wird schreibgeschützt eingebunden)
#GEO_OSM_PBF_FILE=/osm/planet-latest.osm.pbf              # Dateiname im Container
#GEO_SIGHTS_DB=                                           # Standard: sights.sqlite neben dem Cache (GEO_DATA_HOST_DIR)
#GEO_SIGHTS_WORK_DIR=                                     # Zwischendateien beim Bauen (Standard: sights-work/ neben der Datenbank, einige GB)
#GEO_SIGHTS_OSMIUM_INDEX=flex_mem                         # osmium-Ortsindex (flex_mem = Arbeitsspeicher; sparse_file_array,/pfad bei wenig RAM)
#GEO_SIGHTS_WD_DELAY=1.0                                  # Sekunden Pause zwischen zwei Wikidata-Abfragen (50 Objekte je Abfrage)
#GEO_SIGHTS_WD_WORKERS=2                                # Import-Container: gleichzeitige Wikidata-Abfragen (Standard 2; 1 = am schonendsten)
#GEO_TILE_PROXY=true                                     # Karte (Editor, /nearby) ueber /tiles/{z}/{x}/{y} dieses Dienstes laden: noetig, wenn die Seite per HTTPS laeuft und GEO_TILE_URL http://... ist (Mixed Content) oder das Handy den Tileserver nicht direkt erreicht
#GEO_WIKIMEDIA_HOST_DIR=/mnt/ssd/nominatim-planet               # Ordner mit wikimedia-importance.sql.gz (Nominatim), wird schreibgeschuetzt gemountet
#GEO_WIKIMEDIA_IMPORTANCE_FILE=/wikimedia/wikimedia-importance.sql.gz   # Dateiname im Container (.sql.gz oder .csv.gz)
#GEO_SIGHTS_WD_MAXLAG=0                                  # Import-Container: 0 = aus (Standard). >0 = Wikidata-Abfragen warten, solange dessen Replikationsverzoegerung ueber so vielen Sekunden liegt (5 ist oft dauerhaft ueberschritten)
#GEO_SIGHTS_WD_CONTACT=                                  # Import-Container: deine E-Mail oder URL; steht im User-Agent der Wikidata-Abfragen (Wikimedia-Empfehlung, optional)
#GEO_SIGHTS_TR_SCOPE=notable                             # Import-Container, Befehl translate: notable = nur Sehenswuerdigkeiten mit Wikimedia-Wichtigkeit/Sitelinks (Standard), all = alle ohne deutsche Beschreibung
#GEO_SIGHTS_TR_MAX=0                                     # Import-Container, translate: hoechstens so viele Eintraege pro Lauf (0 = alle; zum Testen z.B. 20)
#GEO_SIGHTS_TR_SLEEP=0                                   # Import-Container, translate: Pause in Sekunden zwischen zwei Anfragen (Google-Free-Tier: z.B. 4)
#GEO_SIGHTS_TR_TIMEOUT=60                                # Import-Container, translate: Sekunden je Anfrage an Ollama/Google
#GEO_SIGHTS_TR_RETRY=0                                   # Import-Container, translate: 1 = auch Eintraege erneut fragen, die das Modell mit UNKNOWN beantwortet hat; only = NUR diese (nicht die noch nie gefragten)
#OLLAMA_MODEL_TEXT=qwen2.5:7b-instruct                   # Import-Container, translate: Textmodell fuer die Uebersetzung der Beschreibungen (leer = OLLAMA_MODEL, das ist meist das Bildmodell)
#GOOGLE_AI_MODEL_TEXT=                                   # Import-Container, translate: Google-Textmodell (leer = GOOGLE_AI_MODEL)
#GEO_SIGHTS_TR_LOG=1                                     # Import-Container, translate: 1 = je Eintrag eine Logzeile (Originaltext -> Uebersetzung bzw. Ablehnungsgrund, Standard), 0 = nur Fortschritt alle 50
#GEO_SIGHTS_TR_BATCH=10                                  # Import-Container, translate: Beschreibungen je Anfrage an das Modell (1 = einzeln; abgelehnte Eintraege werden danach einzeln erneut gefragt)
#GEO_SIGHTS_TR_WORKERS=2                                 # Import-Container, translate: gleichzeitige Anfragen (Ollama: OLLAMA_NUM_PARALLEL beachten)
#GEO_TOP_SIGHT_M=60                                      # geo-service: liegt eine wichtige Sehenswürdigkeit innerhalb so vieler Meter, gilt sie als das Motiv (Feld CtxSight, Ort-Zeile der .nfo); 0 = aus
#GEO_TOP_SIGHT_MIN_IMPORTANCE=0.30                       # geo-service: ab welcher Wikimedia-Wichtigkeit (0..1) eine nahe Sehenswürdigkeit als Motiv gilt (eigene Orte immer)
#GEO_SIGHTS_WP_SCOPE=notable                             # Import-Container, Befehl wikitext: notable = nur Sehenswürdigkeiten mit Wikimedia-Wichtigkeit, all = alle mit Wikipedia-Artikel
#GEO_SIGHTS_WP_LANGS=de,en                               # Import-Container, wikitext: Sprachen der Wikipedia-Kurztexte
#GEO_SIGHTS_WP_MAX=0                                     # Import-Container, wikitext: höchstens so viele Artikel pro Lauf (0 = alle)
#GEO_SIGHTS_WP_DELAY=0.5                                 # Import-Container, wikitext: Sekunden Pause zwischen zwei Abfragen (20 Artikel je Abfrage)
#GEO_SIGHTS_WP_WORKERS=2                                 # Import-Container, wikitext: gleichzeitige Abfragen
#GEO_SIGHTS_WP_SENTENCES=3                               # Import-Container, wikitext: höchstens so viele Sätze aus dem Artikelanfang
#GEO_SIGHTS_WP_MAXCHARS=400                              # Import-Container, wikitext: Kurztext höchstens so lang (Satzende bevorzugt)
#GEO_SIGHTS_REFRESH_DAYS=0                               # Automatische Aktualisierung des Sehenswürdigkeiten-Index: alle so viele Tage (0 = aus). Dienst sights-refresh (Profil refresh)
#GEO_SIGHTS_REFRESH_AT=03:30                             # Automatische Aktualisierung: Uhrzeit (HH:MM, Zeitzone des Containers/TZ)
#GEO_SIGHTS_IMPORTANCE_URL=https://downloads.opencagedata.com/public/wikimedia_importance/%YYYYMM%/wikimedia_importance.tsv.gz,https://nominatim.org/data/wikimedia-importance.csv.gz                      # Automatische Aktualisierung: Wikimedia-Importance-Datei, mehrere Adressen mit Komma getrennt (geladen wird die mit dem neuesten Datum; off = nicht laden)
#GEO_SIGHTS_PBF_URL=                                     # Automatische Aktualisierung: Download der Planet-PBF (z.B. https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf, ca. 85 GB); leer = die vorhandene GEO_OSM_PBF_FILE (Nominatim) nutzen
#GEO_DOWNLOAD_HOST_DIR=./downloads                       # Nur compose: Host-Ordner für heruntergeladene Quelldateien (nach /downloads; behalten werden die neueste und die letzte erfolgreich genutzte Version)
#GEO_SIGHTS_REFRESH_WIKITEXT=1                           # Automatische Aktualisierung: auch Wikipedia-Kurztexte holen (0 = nicht)
#GEO_SIGHTS_REFRESH_TRANSLATE=1                          # Automatische Aktualisierung: auch Beschreibungen per LLM übersetzen (braucht AI_PROVIDER; 0 = nicht)
#GEO_SIGHTS_REFRESH_FORCE_BUILD=0                        # Automatische Aktualisierung: 1 = den Index in jedem Lauf neu bauen, auch wenn die PBF gleich ist
#GEO_SIGHTS_KEEP_PREV=1                                  # Beim Neuaufbau die bisherige sights.sqlite als sights.sqlite.prev behalten (Hardlink, kostet keinen Platz zusätzlich; 0 = nicht)
#GEO_PLACE_TRIP_KM=100                                  # Ohne Ordner- und Track-Reise: weiter als so viele km von Zuhause entfernt heißt die Reise Ort und Umgebung (z. B. Triest und Umgebung; 0 = aus; braucht GEO_HOME_LAT/LON oder einen Ort der Art Zuhause)
#GEO_WIKIMEDIA_BUILD_DAYS=30                             # Container wikimedia-build (Profil wikimedia): wikimedia_importance.tsv.gz selbst erzeugen, alle so viele Tage (0 = nur auf Befehl: run --rm wikimedia-build once)
#GEO_WIKIMEDIA_BUILD_AT=03:00                            # wikimedia-build: Uhrzeit des Monatslaufs
#GEO_WIKIMEDIA_LANGUAGES=                                # wikimedia-build: Sprachen, z. B. de,en für einen kleinen schnellen Lauf (leer = alle 39, 9-12 Stunden, ca. 150 GB)
#GEO_WIKIMEDIA_KEEP=2                                    # wikimedia-build: so viele datierte Ergebnisdateien behalten (neueste + die davor)
#GEO_WIKIMEDIA_KEEP_WORK=0                               # wikimedia-build: 1 = Downloads und Datenbank nach einem guten Lauf behalten
#GEO_WIKIMEDIA_WORK_HOST_DIR=./wikimedia-work            # Nur compose: Host-Ordner für Downloads und CSVs von wikimedia-build (ca. 60 GB)
#GEO_WIKIMEDIA_PGDATA_HOST_DIR=./wikimedia-pgdata        # Nur compose: Host-Ordner für die PostgreSQL-Daten von wikimedia-build (ca. 90 GB, am besten NVMe)
#GEO_SIGHTS_TR_LEN_FACTOR=4                              # translate: eine Uebersetzung gilt als zu lang ab Faktor x Laenge des Originals (chinesisch/japanisch/koreanisch: 1,5 x Faktor)
#GEO_SIGHTS_TR_LEN_MIN=200                              # translate: bis zu dieser Zeichenzahl ist jede Antwort lang genug (kurze Quellen)
#GEO_RADAR_STYLE_URL=                                    # /radar: MapLibre-Stil deines tileserver-GL, z. B. http://192.168.1.33:8777/styles/streets/style.json (leer = aus GEO_TILE_URL abgeleitet)
#GEO_RADAR_API=https://api.rainviewer.com/public/weather-maps.json   # /radar: Radarquelle (RainViewer-kompatibel, z. B. eigener LibreWXR: http://<host>:8080/public/weather-maps.json)
#GEO_RADAR_COLOR=2                                       # /radar: Farbschema-ID der Kacheln (2 = Universal Blue)
#GEO_RADAR_OPTIONS=1_0                                   # /radar: smooth_snow der Kachel-URL (1_0 = geglaettet, ohne Schneefarben)
#GEO_RADAR_MAXZOOM=7                                     # /radar: hoechste Zoomstufe der Radarkacheln (RainViewer: 7; darueber wird vergroessert)
