# exiftool_mon.config -- adds an XMP namespace "mon" for the provenance of filled-in GPS.
#
#   XMP-mon:GpsSource           how the position was found        (track-interpolated | track-nearest)
#   XMP-mon:GpsConfidence       0..1 heuristic, see trackmath.confidence()
#   XMP-mon:GpsGapSeconds       time to the nearest track point
#   XMP-mon:GpsUncertaintyM     rough error radius in metres
#   XMP-mon:GpsTrackSources     which GPS histories contributed (Traccar, Dawarich, ...)
#   XMP-mon:TimeBasis           where the capture time came from (sidecar | exif+offset | filename+tz-assumed ...)
#   XMP-mon:ClockDriftSeconds   camera clock error that was corrected (camera minus true time)
#   XMP-mon:ClockDriftMethod    how that error was estimated (gps-time | track-match | none)
#   XMP-mon:GpsFilledBy         tool + version
#
# Unknown namespaces are simply ignored by Immich/Kodi, so this is invisible to them but
# queryable:   exiftool -config exiftool_mon.config -XMP-mon:all -r /mnt/NAS/photo
#
# Use:  exiftool -config /path/to/exiftool_mon.config -XMP-mon:GpsSource=... file.xmp

%Image::ExifTool::UserDefined::mon = (
    GROUPS        => { 0 => 'XMP', 1 => 'XMP-mon', 2 => 'Image' },
    NAMESPACE     => { 'mon' => 'http://ns.neuhofer.home/media/1.0/' },
    WRITABLE      => 'string',
    GpsSource         => { },
    GpsConfidence     => { Writable => 'real' },
    GpsGapSeconds     => { Writable => 'integer' },
    GpsUncertaintyM   => { Writable => 'integer' },
    GpsTrackSources   => { },
    TimeBasis         => { },
    ClockDriftSeconds => { Writable => 'integer' },
    ClockDriftMethod  => { },
    GpsFilledBy       => { },
);

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        mon => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::mon' },
        },
    },
);

1;  # end
