# exiftool_mon.config -- adds an XMP namespace "mon" for the provenance of filled-in GPS.
#
#   XMP-mon:GpsSource           how the position was found        (track-interpolated | track-nearest)
#   XMP-mon:GpsConfidence       0..1 heuristic, see trackmath.confidence()
#   XMP-mon:GpsGapSeconds       time to the nearest track point
#   XMP-mon:GpsUncertaintyM     rough error radius in metres
#   XMP-mon:GpsTrackSources     which GPS histories contributed (Traccar, Dawarich, ...)
#   XMP-mon:TimeBasis           where the capture time came from (sidecar | exif+offset | filename+tz-assumed ...)
#   XMP-mon:ClockDriftSeconds   camera clock error that was corrected (camera minus true time)
#   XMP-mon:ClockDriftMethod    how that error was estimated (gps-time | track-match | none)
#   XMP-mon:GpsFilledBy         tool + version
#   XMP-mon:CameraName          readable camera name (camera_names.json rule > NFO Maker rule > Google list > raw Make Model)
#   XMP-mon:CameraNameSource    where that name came from (override | nfo-rule | google | raw)
#   XMP-mon:CtxDaypart / CtxSeason / CtxMonth / CtxYear / CtxWeekday   time-of-day context of the capture (local time)
#   XMP-mon:CtxLocalTime        capture time in the place's time zone (ISO)
#   XMP-mon:CtxWeather / CtxTempC   weather at that place and time (service /context)
#   XMP-mon:CtxElevation        metres above sea level at that place (service /context, SRTM3 / Open-Meteo)
#   XMP-mon:CtxTimezone         IANA time zone at that place (service /timezoneJSON)
#   XMP-mon:AltitudeSource      where XMP-exif:GPSAltitude came from: camera (own EXIF) | dem (SRTM/Open-Meteo)
#   XMP-mon:CtxTrip             trip name (from the folder name 'YYYY.MM.DD Name')
#   XMP-mon:CtxTripSource       where CtxTrip came from: folder (folder name) | track (detected from the GPS history)
#   XMP-mon:CtxDaylight         light at the capture time ('goldene Stunde (abends)', 'Tag', 'Nacht', ...); CtxSunrise / CtxSunset local HH:MM
#   XMP-mon:CtxMoon             moon phase ('Vollmond (100 %)'); CtxHoliday public holiday at that place ('Ostermontag')
#   XMP-mon:CtxWindKmh / CtxWindText / CtxPrecipMm / CtxCloudPct / CtxHumidityPct   more weather (service /context)
#   XMP-mon:CtxSight            the one sight the photo is most likely OF (within GEO_TOP_SIGHT_M); CtxPlaceVersion: data version the place was resolved with
#   XMP-mon:CtxPois             sights nearby ('Schloss X (Schloss, 120 m); ...'), CtxCountry / CtxCountryInfo   abroad only
#   XMP-mon:CtxClock            camera-clock plausibility ('ok' or the warning text), CtxClockStatus ok | warn
#   XMP-mon:CtxFilledBy         tool + version
#   XMP-mon:CtxTimeBasis        'Dateiname' when the time of day / weather were derived from the file name (no zone-qualified capture date in the sidecar)
#   XMP-mon:CtxSchema           version of the context data set this sidecar is complete for (ctxfill.CTX_SCHEMA): only the newer groups are added later
#   XMP-mon:AiStale / NfoStale  set when new context data arrived AFTER the AI description / .nfo was made (= value of CtxSchema then); cleared once regenerated
#
# Unknown namespaces are simply ignored by Immich/Kodi, so this is invisible to them but
# queryable:   exiftool -config exiftool_mon.config -XMP-mon:all -r /mnt/NAS/photo
#
# Use:  exiftool -config /path/to/exiftool_mon.config -XMP-mon:GpsSource=... file.xmp

%Image::ExifTool::UserDefined::mon = (
    GROUPS        => { 0 => 'XMP', 1 => 'XMP-mon', 2 => 'Image' },
    NAMESPACE     => { 'mon' => 'http://ns.neuhofer.home/media/1.0/' },
    WRITABLE      => 'string',
    GpsSource         => { },
    GpsConfidence     => { Writable => 'real' },
    GpsGapSeconds     => { Writable => 'integer' },
    GpsUncertaintyM   => { Writable => 'integer' },
    GpsTrackSources   => { },
    TimeBasis         => { },
    ClockDriftSeconds => { Writable => 'integer' },
    ClockDriftMethod  => { },
    GpsFilledBy       => { },
    CameraName        => { },
    CameraNameSource  => { },
    CtxDaypart        => { },
    CtxSeason         => { },
    CtxMonth          => { },
    CtxYear           => { Writable => 'integer' },
    CtxWeekday        => { },
    CtxLocalTime      => { },
    CtxWeather        => { },
    CtxTempC          => { Writable => 'real' },
    CtxElevation      => { Writable => 'real' },
    CtxTimezone       => { },
    AltitudeSource    => { },
    CtxTrip           => { },
    CtxTripSource     => { },
    CtxDaylight       => { },
    CtxSunrise        => { },
    CtxSunset         => { },
    CtxMoon           => { },
    CtxHoliday        => { },
    CtxWindKmh        => { Writable => 'real' },
    CtxWindText       => { },
    CtxPrecipMm       => { Writable => 'real' },
    CtxCloudPct       => { Writable => 'real' },
    CtxHumidityPct    => { Writable => 'real' },
    CtxPois           => { },
    CtxSight          => { },
    CtxPlaceVersion   => { },
    CtxCountry        => { },
    CtxCountryInfo    => { },
    CtxClock          => { },
    CtxClockStatus    => { },
    CtxFilledBy       => { },
    CtxTimeBasis      => { },
    CtxSchema         => { Writable => 'integer' },
    AiStale           => { Writable => 'integer' },
    NfoStale          => { Writable => 'integer' },
);

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        mon => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::mon' },
        },
    },
);

1;  # end
